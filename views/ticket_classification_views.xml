<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ticket_classification_tree" model="ir.ui.view">
        <field name="name">ticket.classification.tree</field>
        <field name="model">ticket.classification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ticket_classification_form" model="ir.ui.view">
        <field name="name">ticket.classification.form</field>
        <field name="model">ticket.classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="is_default"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
              
              
    <record id="action_ticket_classification" model="ir.actions.act_window">
        <field name="name">تصنيفات التذاكر</field>
        <field name="res_model">ticket.classification</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_ticket_classification" name="التصنيفات"
              parent="docflex_config_menue"
              action="action_ticket_classification"/>
</odoo>