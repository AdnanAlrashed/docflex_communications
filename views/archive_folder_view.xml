    <!-- العرض الأساسي (الأصلي) لمجلدات الأرشيف -->
    <record id="view_archive_folder_form_improved" model="ir.ui.view">
        <field name="name">archive.folder.form.improved</field>
        <field name="model">archive.folder</field>
        <field name="arch" type="xml">
            <form string="مجلد الأرشيف">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                            <span class="badge" invisible="folder_type != 'department'">
                                رئيسي
                            </span>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="folder_type"/>
                            <field name="parent_id" context="{'show_path': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_start" invisible="folder_type != 'year'"/>
                            <field name="date_end" invisible="folder_type != 'year'"/>
                            <field name="color" widget="color_picker"/>
                            <field name="depth_level" widget="stat_info"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الوصف">
                            <field name="description"/>
                        </page>
                        <page string="المحتويات">
                            <field name="documents_count" widget="statinfo"/>
                            <field name="document_ids" mode="kanban,list,form">
                                <list>
                                    <field name="name"/>
                                    <field name="reference"/>
                                    <field name="date"/>
                                    <field name="document_type"/>
                                    <field name="state"/>
                                </list>
                            </field>

                        </page>
                        <page string="الهيكل التنظيمي" invisible="not child_ids">
                            <field name="child_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="folder_type"/>
                                    <field name="documents_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- عرض الشجرة المعدل -->
    <record id="view_archive_folder_tree_improved" model="ir.ui.view">
        <field name="name">archive.folder.list.improved</field>
        <field name="model">archive.folder</field>
        <field name="arch" type="xml">
            <list string="مجلدات الأرشيف" decoration-info="depth_level==0" decoration-warning="depth_level>3">
                <field name="name"/>
                <field name="folder_type" widget="badge"/>
                <field name="complete_name" invisible="1"/>
                <field name="depth_level" widget="progressbar" options="{'max_value': 5, 'editable': False}"/>
                <field name="documents_count" widget="statinfo"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

